{
    "layer": "top",
    "position": "bottom",
    "height": 30,
    "spacing": 4,

    "modules-left": ["sway/workspaces", "sway/mode", "sway/window"],
    "modules-center": ["image#viz", "mpris", "custom/viz"],
    "modules-right": ["custom/docker", "network", "cpu", "temperature", "memory", "disk", "backlight", "pulseaudio", "pulseaudio#mic", "battery", "power-profiles-daemon", "custom/language", "tray", "clock"],

    "sway/workspaces": {
        "disable-scroll": false,
        "format": "{name}"
    },

    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },

    "sway/window": {
        "max-length": 50
    },

    "mpris": {
        "format": "{player_icon} {artist} – {title}",
        "format-paused": "{status_icon} {artist} – {title}",
        "player-icons": {
            "default": "▶",
            "mpv": "🎵"
        },
        "status-icons": {
            "paused": "⏸"
        },
        "max-length": 60,
        "ignored-players": ["firefox"]
    },

    // Mini spectrum from viz (~/dev/personal/viz); hides itself when nothing plays.
    // Click switches bars/braille, middle-click opens viz, right-click plays/pauses.
    // Hovering shows the track card.
    "custom/viz": {
        "exec": "~/.nix-profile/bin/viz bar",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "~/.nix-profile/bin/viz bar --toggle",
        "on-click-middle": "~/.nix-profile/bin/viz-launch",
        "on-click-right": "playerctl -p spotify play-pause"
    },

    // The current cover, kept up to date by `viz bar` (it signals RTMIN+9 on changes).
    "image#viz": {
        "exec": "f=\"$HOME/.cache/viz/bar-cover.png\"; [ -f \"$f\" ] && echo \"$f\"",
        "size": 22,
        "interval": 10,
        "signal": 9,
        "on-click": "~/.nix-profile/bin/viz-launch"
    },

    "network": {
        "format-wifi": " {essid} ({signalStrength}%)",
        "format-ethernet": " {ipaddr}",
        "format-disconnected": "⚠ Disconnected",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "nm-connection-editor"
    },

    "cpu": {
        "format": "💻 {usage}%",
        "tooltip": false,
        "interval": 5
    },

    "memory": {
        "format": "🧠 {used:0.1f}G",
        "interval": 10,
        "states": {
            "high": 66
        }
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["🔅", "🔆"],
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "🔇 {volume}%",
        "format-icons": {
            "headphone": "🎧",
            "hands-free": "🎧",
            "headset": "🎧",
            "phone": "📱",
            "portable": "📱",
            "car": "🚗",
            "default": ["🔈", "🔉", "🔊"]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    // Microphone state, driven by the same default source the XF86AudioMicMute
    // key toggles (sway/config). All four format-* variants forward to
    // {format_source} so the sink's own mute/bluetooth state can't hijack it.
    "pulseaudio#mic": {
        "format": "{format_source}",
        "format-muted": "{format_source}",
        "format-bluetooth": "{format_source}",
        "format-bluetooth-muted": "{format_source}",
        "format-source": "",
        "format-source-muted": "<span color=\"#e0645a\"></span>",
        "tooltip-format": "Mic: {desc}",
        "on-click": "~/dotfiles/scripts/mic.sh mute",
        "on-scroll-up": "~/dotfiles/scripts/mic.sh up",
        "on-scroll-down": "~/dotfiles/scripts/mic.sh down"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "🔋 {capacity}%",
        "format-charging": "⚡ {capacity}%",
        "format-plugged": "🔌 {capacity}%",
        "format-critical": "🪫 {capacity}%"
    },

    "temperature": {
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 85,
        "interval": 5,
        "format": "🌡 {temperatureC}°C",
        "format-critical": "🔥 {temperatureC}°C"
    },

    "disk": {
        "path": "/",
        "interval": 30,
        "format": "💽 {percentage_used}%",
        "tooltip-format": "{used} used of {total} ({free} free)"
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip": true,
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "format-icons": {
            "default": "⚡",
            "performance": "🚀",
            "balanced": "⚖️",
            "power-saver": "🌱"
        }
    },

    "custom/docker": {
        "exec": "~/dotfiles/scripts/waybar-docker.sh",
        "return-type": "json",
        "interval": 10,
        "tooltip": true,
        "on-click": "kitty --class docker-tui -e lazydocker"
    },

    "custom/language": {
        "exec": "~/dotfiles/scripts/waybar-layout.sh",
        "restart-interval": 5,
        "tooltip": false,
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
    },

    "tray": {
        "spacing": 8
    },

    "clock": {
        "format": " {:%a %d %b  %H:%M  ·  w%V}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    }
}
